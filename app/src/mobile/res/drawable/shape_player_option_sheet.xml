<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/xg_sheet_option_fill_active" />
            <stroke android:width="1dp" android:color="@color/xg_sheet_option_line_active" />
            <corners android:radius="8dp" />
            <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/xg_sheet_option_fill_active" />
            <stroke android:width="1dp" android:color="@color/xg_sheet_option_line_active" />
            <corners android:radius="8dp" />
            <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/xg_sheet_option_fill" />
            <stroke android:width="1dp" android:color="@color/xg_sheet_option_line" />
            <corners android:radius="8dp" />
            <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
