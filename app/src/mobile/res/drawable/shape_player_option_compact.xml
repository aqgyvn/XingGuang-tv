<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/xg_control_fill_active" />
            <stroke android:width="1dp" android:color="@color/xg_primary" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/xg_control_fill" />
            <stroke android:width="1dp" android:color="@color/xg_line" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
